# Copia este ficheiro para .env (na mesma pasta do config.yaml) e preenche.
# O config.yaml refere estas variáveis com a sintaxe ${NOME}.

# Bot do Telegram (cria um com o @BotFather) e ID do chat que recebe as mensagens.
CDD_TELEGRAM_TOKEN=123456789:AAExemploDeTokenDoBotFather
CDD_TELEGRAM_CHAT_ID=123456789

# Uma password por conta ChildDiary (os nomes têm de coincidir com o config.yaml).
CDD_PASSWORD_CRECHE=password-da-conta-da-creche
